#!/usr/bin/bash

trap "kill 0" EXIT

mosquitto -c /etc/mosquitto/mosquitto.conf -v > /dev/null 2>&1 & 

source .env/bin/activate

echo "[INFO] Starting FastAPI..."
uvicorn main:app --host 0.0.0.0 --port 8000 &

sleep 1

echo "[INFO] Starting Streamlit..."
PYTHONPATH=. streamlit run streamlit/Dashboard.py --server.address 0.0.0.0
