st.markdown(hide_menu, unsafe_allow_html=True)

# =========================
# LOAD DATA (NO SQL HERE)
# =========================
def load_data():
    rows = get_all_data(200)

    records = []

    for device_id, data, timestamp in rows:
        try:
            parsed = json.loads(data)

            records.append({
                "device": device_id,
                "temp": parsed.get("temp"),
                "hum": parsed.get("hum"),
                "time": timestamp
            })
        except:
            pass

    return pd.DataFrame(records)


# Setup
df = load_data()

if df.empty:
    st.warning("Belum ada data masuk...")
    st.stop()

devices = sorted(df["device"].unique())

# =========================
# UI
# =========================

images = [
    "https://placehold.co/800x450/1E2129/white?text=Slide+1",
    "https://placehold.co/800x450/FF4B4B/white?text=Slide+2",
    "https://placehold.co/800x450/31333F/white?text=Slide+3"
]
current_img = images[count % len(images)]

# 4. Layout 1/3 dan 2/3
col_left, col_right = st.columns([1.4, 2])

with col_left:
