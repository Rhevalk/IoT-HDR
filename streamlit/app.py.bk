        components.cardInfoTanaman("Hidroponik")

    target_device = devices[0]
    device_df = df[df["device"] == target_device]
    latest_data = device_df.iloc[-1]

    col1, col2 = st.columns(2)
    
    with col1:
        with st.container(border=True):
            st.markdown(f"""
            **Temperatur**
            # {latest_data['temp']} °C
            """)
    
    with col2:
        with st.container(border=True):
            st.markdown(f"""
            **Humidity**
            # {latest_data['hum']} %
            """)

    with st.container(border=True):
        st.line_chart(device_df[["temp", "hum"]], width='stretch')

with col_right:
    # Menampilkan gambar yang berganti otomatis (Slider)
    col1, col2 = st.columns([3, 1])
    with col1:
        st.image(current_img)

    with col2:
        with st.container(border=True):
            st.markdown(f"""
            ## Kolam Ikan
            **Suhu Air**
            # {latest_data['hum']} %
            """)


    # Kolam Ikan
    col_info1, col_info2 = st.columns(2)
