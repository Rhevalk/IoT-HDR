# =========================
# LOAD DATA (NO SQL HERE)
# =========================
def load_data():
    rows = get_all_data(200)

    records = []

    for device_id, data, timestamp in rows:
        try:
            parsed = json.loads(data)

            records.append({
                "device": device_id,
                "temp": parsed.get("temp"),
                "hum": parsed.get("hum"),
                "time": timestamp
            })
        except:
            pass

    return pd.DataFrame(records)


